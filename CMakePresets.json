{
    "version": 6,
    "configurePresets": [
        {
            "name": "gcc-debug",
            "generator": "Ninja",
            "binaryDir": "build/gcc-debug",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "g++-15",
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "gcc-release",
            "generator": "Ninja",
            "binaryDir": "build/gcc-release",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "g++-15",
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "gcc-asan",
            "generator": "Ninja",
            "binaryDir": "build/gcc-asan",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "g++-15",
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "USE_ASAN": "ON"
            }
        },
        {
